{
  "name": "dsh-mini-remote",
  "version": "0.1.1",
  "description": "DSH 极简移动端遥控器：只把「你的指令」和「AI 的最终回复」送到手机，屏蔽全部中间过程。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client/client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.5-rc.2"
  },
  "author": "xingzhen199186",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingzhen199186/dsh-mini-remote.git"
  },
  "homepage": "https://github.com/xingzhen199186/dsh-mini-remote#readme",
  "bugs": {
    "url": "https://github.com/xingzhen199186/dsh-mini-remote/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mobile",
    "remote",
    "minimal"
  ],
  "license": "MIT",
  "disclosure": {
    "transport": "手机与电脑之间走 http 还是 https，取决于你选哪条路：内网是明文 http；Tailscale 默认也是明文 http，可以另开一个加密的 https 地址；Cloudflare 公网隧道是 https。访问口令随 URL 传递，所以公网隧道那条路请不要在不可信网络里用。",
    "storage": "不保存对话内容之外的任何凭据。cloudflared 二进制按需下载到 DSH 数据目录，不上传。",
    "telemetry": "不收集、不上传任何数据。",
    "network": "启用公网隧道时，流量经 Cloudflare 中转；内网和 Tailscale 两条路不经过任何第三方。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
