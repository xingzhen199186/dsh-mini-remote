<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 相机拍完先落在这里，再把 content:// 交回网页（2026-11-06）。 -->
    <cache-path name="camera" path="camera/" />
    <!-- 下载好的安装包放在这里，装完即弃（2026-11-09）。 -->
    <cache-path name="update" path="update/" />
    <!-- App 私有目录里的文件，用 FileProvider 交出去给系统应用打开（2026-11-17）。 -->
    <files-path name="files" path="." />
    <!-- 全盘模式下的公共文件。只在用户已授予「所有文件访问」时才可读；
         FileProvider 本身不会绕过权限，路径仍由 App 校验。 -->
    <external-path name="external" path="." />
</paths>
