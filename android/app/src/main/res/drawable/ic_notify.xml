<?xml version="1.0" encoding="utf-8"?>
<!-- 状态栏小图标：一条鲸鱼剪影（2026-11-09）。

     **为什么不再用启动图缩放**：启动图是一整幅彩色插画（鲸鱼在一台圆角小设备里），
     取它的轮廓缩到 24dp，得到的就是一个圆角方块——状态栏里显示成实心方块的正是它。
     状态栏图标必须是**单色、极简、24dp 还认得出**的图形，所以这里是一条手绘的鲸鱼：
     身子 + 尾鳍 + 两个喷气泡，眼睛用 evenOdd 挖空。

     颜色写死白色：Android 会把状态栏图标统一染色，这里只负责形状。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M2.6,14.1
            C2.6,10.3 6.1,7.6 10.2,7.6
            C13.6,7.6 16.2,9.2 17.6,11.8
            L20.4,9.7 C21.3,9.1 22.1,9.8 21.8,10.8 L20.7,14.1
            L21.8,17.4 C22.1,18.4 21.3,19.1 20.4,18.5 L17.6,16.4
            C16.2,19 13.6,20.6 10.2,20.6
            C6.1,20.6 2.6,17.9 2.6,14.1 Z
            M7.2,12.4 a1.25,1.25 0 1,0 2.5,0 a1.25,1.25 0 1,0 -2.5,0 Z" />

    <!-- 喷出的两个气泡：让"鲸"这个意思在一眼之间成立 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M6.2,6.3 a1.1,1.1 0 1,1 0.01,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9.6,4.7 a0.85,0.85 0 1,1 0.01,0 Z" />
</vector>
