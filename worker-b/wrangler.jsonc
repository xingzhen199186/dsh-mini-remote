{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dsh-b-relay",
  "workers_dev": false,
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsh-b-relay",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "B_SUFFIX": "dsh-everywhere.com",
    "B_CONTROL_HOST": "control.dsh-everywhere.com",
    "B_ACCOUNT_ID": "c388ee35863086d5ffbcee0bb4b63e0b",
    "B_ZONE_ID": "f2cc2bd5058c743656e938494cdee309"
  },
  "routes": [
    { "pattern": "control.dsh-everywhere.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
  // Workers Secrets: CF_API_TOKEN, B_PEPPER, ADMIN_TOKEN. Never put them in vars.
}
