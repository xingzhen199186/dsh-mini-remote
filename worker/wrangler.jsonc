{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dsh-mini-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsh-mini-relay",
      "database_id": "7a2df92e-02c9-40e5-9ffe-f8cad48569cd",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RELAY_KV",
      "id": "e7deca783d2b4085842387c77229a24d"
    }
  ],
  "vars": {
    "RELAY_PUBLIC_SUFFIX": ".dsh-mini-remote.com",
    "RELAY_CONTROL_HOST": "relay.dsh-mini-remote.com",
    "RELAY_INVITE_REQUIRED": "1"
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "relay.dsh-mini-remote.com", "custom_domain": true }
  ]
}
